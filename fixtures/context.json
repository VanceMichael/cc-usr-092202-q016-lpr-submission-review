  "actors": [
    "报价机构经办",
    "利率管理人员",
    "审核人员",
    "审计人员",
    "贷款账户系统",
    "客户服务人员"
  ],
  "facts": [
    "LPR分别公布一年期和五年期以上报价",
    "本次报价在下一次发布前有效",
    "贷款合同可能在不同日期引用生效基准",
    "报价以百分数报送，步长为0.05个百分点",
    "报价来件可能同时来自邮件与表格",
    "正式公布前其他机构的报价不得相互泄露"
  ],
  "constraints": [
    "报价机构准入：仅名单内有效机构可报送",
    "分期限报送：一年期与五年期以上分别受理保存",
    "报送窗口：窗口前拒收，截止前更正生成新版本并保留修订理由",
    "截止后补报只登记备查，不进入当期计算",
    "格式校验：单位、数值、精度、来源说明不合规即标记",
    "异常提示：相对同期限中位数显著偏离仅提示不自动剔除",
    "回避分派：与机构有利害关系的审核员不得承办该机构材料",
    "双人确认：剔除、恢复与重复作废均须两名不同审核员签署并记录当时规则",
    "冻结阻断：缺报、重复未认定、单位错误、待确认处置或法定数量不足不得冻结",
    "机构隔离：机构只能查看自身材料，冻结包仅供中心审核与审计",
    "计算输入冻结：冻结包列出纳入范围、排除理由、异常提示与签署记录并附摘要"
  ],
